// Config de fastfetch para RuloGamerOS.
// El logo real (foto del pack, vía protocolo Kitty) lo inyecta el wrapper
// /usr/local/bin/fastfetch -- esta config solo decide qué información se
// muestra al lado.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " -> "
    },
    "modules": [
        {
            "type": "custom",
            "format": "RuloGamerOS"
        },
        "break",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "de",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "break",
        "colors"
    ]
}
